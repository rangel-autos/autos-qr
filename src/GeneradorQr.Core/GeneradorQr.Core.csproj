<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GeneradorQr.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/rangel-logo.png" LogicalName="GeneradorQr.Core.Assets.rangel-logo.png" />
    <EmbeddedResource Include="Assets/Fonts/*.ttf" LogicalName="GeneradorQr.Core.Assets.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
